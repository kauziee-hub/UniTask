# Local storage is the safe default; it does not require AWS credentials or resources.
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=uploads
DATABASE_URL=sqlite:///./unitask.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional S3 configuration. Keep STORAGE_PROVIDER=local until the bucket is
# explicitly approved and created. Credentials are resolved from the AWS profile;
# never put access keys or tokens in this file.
S3_BUCKET=unitask-ai-timetable-demo-2026-1931
AWS_REGION=ap-south-1
AWS_PROFILE=unitask-demo
