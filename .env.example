# Copy to backend/.env. Never put AWS access keys or real secrets in this file.

# --- Storage: "local" (default, no AWS needed) or "s3"
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=uploads
S3_BUCKET=unitask-ai-timetable-demo-2026-1931
AWS_REGION=ap-south-1
AWS_PROFILE=unitask-demo

# --- Database (relative SQLite paths resolve inside backend/)
DATABASE_URL=sqlite:///./unitask.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# --- Accounts: "local" (passwords hashed in the database) or "cognito"
AUTH_PROVIDER=local
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
# Signs sessions and encrypts stored Teams tokens. If empty, a dev key is generated in backend/.secret_key.
UNITASK_SECRET_KEY=

# --- Microsoft Teams (see docs/TEAMS_SETUP.md)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=organizations
# MS_REDIRECT_URI defaults to ${FRONTEND_URL}/api/integrations/teams/callback
TEAMS_AUTO_SYNC_MINUTES=30

# --- AI (tutor, grounded answers, syllabus and timetable reading). Server-side only.
# LLM_PROVIDER=bedrock uses the task/instance role; LLM_FALLBACK is tried when the primary fails.
LLM_PROVIDER=gemini
LLM_FALLBACK=
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash
LLM_FAST_MODEL=gemini-flash-lite-latest
BEDROCK_MODEL_ID=
BEDROCK_FAST_MODEL_ID=
# OCR for scans and photos: textract | llm | none
OCR_PROVIDER=llm

# --- Jobs, scheduling, email
# JOB_QUEUE: local (thread pool) | inline (in the request) | sqs (needs SQS_QUEUE_URL and `python -m app.worker`)
JOB_QUEUE=local
# SCHEDULER: internal (loop in the API process) | external (EventBridge calls POST /internal/cron/{job})
SCHEDULER=internal
CRON_SECRET=
EMAIL_PROVIDER=log
SES_FROM_ADDRESS=
# Create the synthetic demo accounts on first start (docs/DEMO.md)
SEED_DEMO=false
# Password-free entry to the shared synthetic student/teacher workspaces. Demo deployments only.
DEMO_MODE=false
